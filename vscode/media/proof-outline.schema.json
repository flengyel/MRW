{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "description": {
      "$ref": "#/$defs/explanation"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "maxItems": 16,
      "minItems": 0
    },
    "scopes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scope"
      },
      "maxItems": 16,
      "minItems": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "maxItems": 64,
      "minItems": 1
    },
    "inferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inference"
      },
      "maxItems": 128,
      "minItems": 0
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_-]{0,63}$",
        "maxLength": 64
      },
      "maxItems": 64,
      "minItems": 1
    },
    "suggested_hidden": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_-]{0,63}$",
        "maxLength": 64
      },
      "maxItems": 64,
      "minItems": 0
    }
  },
  "required": [
    "version",
    "title",
    "description",
    "sources",
    "scopes",
    "nodes",
    "inferences",
    "goals",
    "suggested_hidden"
  ],
  "additionalProperties": false,
  "$defs": {
    "explanation": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "origin": {
          "enum": [
            "ai_proposal",
            "human"
          ]
        }
      },
      "required": [
        "text",
        "author",
        "origin"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Relative path from the outline, copied exactly from the handoff."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://",
          "maxLength": 2048
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "review": {
          "enum": [
            "published",
            "human_reviewed",
            "awaiting_human_review"
          ]
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "id",
        "title",
        "file",
        "sha256",
        "url",
        "revision",
        "review"
      ],
      "additionalProperties": false
    },
    "citation": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "start_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "end_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "declaration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "^mrw-outline:v1/"
        }
      },
      "required": [
        "source",
        "start_line",
        "end_line"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "parent": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 32,
          "minItems": 0
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 32,
          "minItems": 0
        }
      },
      "required": [
        "id",
        "parent",
        "variables",
        "assumptions"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "explanation": {
          "$ref": "#/$defs/explanation"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          },
          "maxItems": 12,
          "minItems": 0
        }
      },
      "required": [
        "id",
        "title",
        "claim",
        "explanation",
        "scope",
        "citations"
      ],
      "additionalProperties": false
    },
    "inference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "premises": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "maxItems": 16,
          "minItems": 1
        },
        "conclusion": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "explanation": {
          "$ref": "#/$defs/explanation"
        },
        "discharges": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "maxItems": 16,
          "minItems": 0
        }
      },
      "required": [
        "id",
        "premises",
        "conclusion",
        "explanation",
        "discharges"
      ],
      "additionalProperties": false
    }
  },
  "description": "MRW proof outline v1. The core additionally checks references, unique identifiers, DAG structure, joint-premise projection and scope discharge. These are structural checks, not mathematical checking."
}
