{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "source_set",
    "attribution",
    "claims",
    "grounds",
    "goal"
  ],
  "properties": {
    "schema": {
      "const": "mrw.grounds-proposal"
    },
    "version": {
      "const": 1
    },
    "source_set": {
      "type": "string",
      "format": "uuid"
    },
    "attribution": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "text",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        }
      }
    },
    "grounds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason",
          "premises",
          "conclusion",
          "sources",
          "scope",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "premises": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "conclusion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    }
  }
}
