    "menus": {
      "view/title": [
        {
          "command": "mrw.copyDocumentLink",
          "when": "view == mrw.readingOutline",
          "group": "0_documents@7"
        },
        {
          "command": "mrw.openDocumentInObsidian",
          "when": "view == mrw.readingOutline",
          "group": "0_documents@6"
        },
        {
          "command": "mrw.editDocumentSource",
          "when": "view == mrw.readingOutline",
          "group": "0_documents@5"
        },
        {
          "command": "mrw.revealReadingDocument",
          "when": "view == mrw.readingOutline",
          "group": "navigation"
        },
        {
          "command": "mrw.returnToReadingOutline",
          "when": "view == mrw.readingOutline",
          "group": "navigation"
        },
        {
          "command": "mrw.refreshReadingOutline",
          "when": "view == mrw.readingOutline",
          "group": "1_reading@1"
        },
        {
          "command": "mrw.openReadingOutline",
          "when": "view == mrw.readingOutline",
          "group": "1_reading@0"
        },
        {
          "command": "mrw.showBacklinks",
          "when": "view == mrw.readingOutline",
          "group": "0_documents@3"
        },
        {
          "command": "mrw.setupWorkspace",
          "when": "view == mrw.commands",
          "group": "4_help@0"
        },
        {
          "command": "mrw.readingTools",
          "when": "view == mrw.commands || view == mrw.readingOutline",
          "group": "tools@0"
        },
        {
          "command": "mrw.sourceTools",
          "when": "view == mrw.commands || view == mrw.readingOutline",
          "group": "tools@1"
        },
        {
          "command": "mrw.calculationTools",
          "when": "view == mrw.commands || view == mrw.readingOutline",
          "group": "tools@2"
        },
        {
          "command": "mrw.proofTools",
          "when": "view == mrw.commands || view == mrw.readingOutline",
          "group": "tools@3"
        },
        {
          "command": "mrw.companionTools",
          "when": "view == mrw.commands || view == mrw.readingOutline",
          "group": "tools@4"
        },
        {
          "command": "mrw.earlierWork",
          "when": "view == mrw.commands || view == mrw.readingOutline",
          "group": "tools@5"
        },
        {
          "command": "mrw.openOutline",
          "when": "view == mrw.readingOutline",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "mrw.mark",
          "when": "resourceScheme == file",
          "group": "mrw"
        },
        {
          "command": "mrw.openProof",
          "when": "resourceScheme == file",
          "group": "mrw"
        },
        {
          "command": "mrw.ask",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == untitled)",
          "group": "mrw"
        },
        {
          "command": "mrw.createOutline",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == mrw-record)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.addOutlineRegion",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == mrw-record)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.replaceOutlineRegion",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == mrw-record)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.setOutlineStatement",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == mrw-record)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.addOutlineContext",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == mrw-record)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.insertOutlineReference",
          "when": "editorLangId == markdown && (resourceScheme == file || resourceScheme == untitled)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.followOutlineReference",
          "when": "editorLangId == markdown && (resourceScheme == file || resourceScheme == untitled)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.openReadingOutline",
          "when": "editorLangId == markdown && (resourceScheme == file || resourceScheme == untitled)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.followDocumentLink",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.showBacklinks",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "mrw-outline"
        }
      ],
      "commandPalette": [
        {
          "command": "mrw.followWikiLink",
          "when": "false"
        },
        {
          "command": "mrw.selectReadingOutlineItem",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "submenu": "mrw.documentNavigation",
          "when": "resourceScheme =~ /^(file|vscode-remote)$/ && (resourceExtname =~ /\\.(md|markdown|pdf|txt)$/i)",
          "group": "navigation@10"
        },
        {
          "command": "mrw.openProofOutline",
          "when": "resourceFilename =~ /\\.mrw-proof\\.json$/",
          "group": "navigation"
        },
        {
          "command": "mrw.resumeProofStudy",
          "when": "resourceFilename =~ /\\.mrw-study\\.json$/",
          "group": "navigation"
        },
        {
          "command": "mrw.leanStudyActions",
          "when": "resourcePath in mrw.leanLessonPaths",
          "group": "navigation@20"
        },
        {
          "command": "mrw.leanStudyInfo",
          "when": "resourcePath in mrw.leanLessonPaths && resourceExtname == .lean",
          "group": "4_mrw@2"
        }
      ],
      "view/item/context": [],
      "notebook/toolbar": [
        {
          "command": "mrw.retainNotebookResult",
          "when": "notebookType == jupyter-notebook",
          "group": "mrw"
        }
      ],
      "mrw.documentNavigation": [
        {
          "command": "mrw.returnToReadingOutline",
          "group": "1_navigation@1"
        },
        {
          "command": "mrw.showBacklinks",
          "group": "1_navigation@2"
        },
        {
          "command": "mrw.openReadingOutline",
          "when": "resourceScheme =~ /^(file|vscode-remote)$/ && (resourceExtname =~ /\\.(md|markdown)$/i)",
          "group": "1_navigation@3"
        },
        {
          "command": "mrw.editDocumentSource",
          "when": "resourceScheme =~ /^(file|vscode-remote)$/ && (resourceExtname =~ /\\.(md|markdown)$/i)",
          "group": "2_note@1"
        },
        {
          "command": "mrw.openDocumentInObsidian",
          "when": "resourceScheme =~ /^(file|vscode-remote)$/ && (resourceExtname =~ /\\.(md|markdown)$/i)",
          "group": "2_note@2"
        },
        {
          "command": "mrw.copyDocumentLink",
          "when": "resourceScheme =~ /^(file|vscode-remote)$/ && (resourceExtname =~ /\\.(md|markdown)$/i)",
          "group": "2_note@3"
        },
        {
          "command": "mrw.newZettel",
          "group": "2_notes@0"
        },
        {
          "command": "mrw.recentNotes",
          "group": "2_notes@1"
        },
        {
          "command": "mrw.refreshCitations",
          "when": "resourceExtname == .md",
          "group": "1_reading@8"
        }
      ]
    },
    "configuration": {
      "title": "Mathematical Research Workstation",
      "properties": {
        "mrw.obsidianVault": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Obsidian vault name or ID used by New Note and Open Note in Obsidian. Empty uses the selected notes folder's name. The notes folder must be the vault root."
        },
        "mrw.notesFolder": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Notes folder for WikiLinks and backlinks. Use an absolute path on the extension host; in WSL use /mnt/c/Users/\u2026 for a Windows folder. Obsidian is optional. Choose Notes Folder updates this workspace setting."
        },
        "mrw.pythonExecutable": {
          "type": "string",
          "default": "python3",
          "scope": "machine",
          "description": "Python 3.11+ executable on the extension host. One executable, without shell arguments. Configure in User or Remote settings."
        },
        "mrw.proofViewerUrl": {
          "type": "string",
          "default": "https://arkitect-lab.k-inside.com/proofmaps/",
          "scope": "machine",
          "description": "HTTPS proof viewer opened only by its explicit command. No local source or path is appended or uploaded."
        },
        "mrw.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "OpenAI model identifier. If empty, Ask prompts for this request. Credentials come only from OPENAI_API_KEY on the extension host."
        },
        "mrw.navigationWorkspaceUri": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional stable workspace routing URI for companion links. File URI on Linux or vscode-remote://ssh-remote+HOST/path. WSL uses WSL_DISTRO_NAME automatically. This must name the current folder or saved workspace file; target identity remains independently scoped."
        },
        "mrw.artifactMoveDestination": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Suggested destination for Move Saved Work Directory. Changing this setting never changes the active store or moves saved work; use the explicit command."
        },
        "mrw.studyQuestions": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Questions per short study block. Prototype default; stops at an attempt boundary."
        },
        "mrw.studyMinutes": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 30,
          "description": "Approximate minutes per block. Time is not a mental-effort measure."
        },
        "mrw.studyNewQuestions": {
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "maximum": 3,
          "description": "Maximum new questions per block. Saved questions enter continuing review only by Keep for review."
        },
        "mrw.dataDirectory": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Suggested MRW data directory, independent of notes or Obsidian. Use Configure History to import and verify before connecting. Only its History subfolder is managed. Changing this setting alone does not change the active binding."
        },
        "mrw.usageRecording": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Record MRW command, bridge and study action counts and durations. No arguments or prompt text are collected for counts. Disabling does not erase earlier history or stop the existing study evidence/snapshot records."
        },
        "mrw.leanStudyParent": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Parent directory for new Lean study projects. Set Up MRW Workspace uses ~/mrw-work on Linux. Empty uses the notes folder or asks. Existing study locations are preserved."
        },
        "mrw.obsidianNewNoteCommand": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Obsidian command ID that creates a note using your vault\u2019s template (for example templater-obsidian:create-Templates/NewFileTemplate.md). Required for New Note in a vault; there is no plain-file fallback. Do not use an insert-template command. Requires Obsidian CLI; Obsidian owns prompts, naming and template execution."
        },
        "mrw.obsidianExecutable": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Obsidian CLI executable, without arguments. Empty uses obsidian on PATH, Obsidian.com on Windows, or the standard Windows user installation from WSL. Enable Obsidian Settings \u2192 General \u2192 Command line interface."
        },
        "mrw.zettelValidator": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the existing `flengyel/Zettel` `python/zettel_validate.py` on this host. Used only when Zettel format is explicitly selected for an annotation continuation. Requires PyYAML in MRW\u2019s Python environment; does not modify notes."
        },
        "mrw.citationExecutable": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Trusted Pandoc executable for native-preview citations. Empty uses host PATH (pandoc, then pandoc.exe on WSL). No executable is taken from note metadata or vault configuration."
        },
        "mrw.citationBibliography": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Local bibliography fallback when the note has no bibliography metadata. Relative paths resolve beside the note within the selected notes/workspace root. Empty can reuse the selected vault\u2019s Pandoc Reference List bibliography."
        },
        "mrw.citationStyle": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Local independent CSL style fallback. Empty uses note csl metadata or Pandoc\u2019s default; no remote styles are fetched."
        },
        "mrw.citationSource": {
          "type": "string",
          "enum": [
            "auto",
            "bibliography",
            "zotero"
          ],
          "default": "auto",
          "scope": "machine-overridable",
          "description": "Citation metadata source. Auto respects note/explicit bibliographies, then the selected vault\u2019s live-Zotero option or a connected personal Zotero library, otherwise its local bibliography. Zotero uses Better BibTeX exact-key read-only lookup."
        },
        "mrw.citationZoteroLibraries": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "maxItems": 8,
          "uniqueItems": true,
          "default": [],
          "scope": "machine-overridable",
          "description": "Optional Better BibTeX library IDs for live citations. These are not Zotero Web API group IDs. Empty uses the selected vault\u2019s Zotero libraries or My Library. No wildcard lookup is performed."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "mrw.commands",
        "contents": "[Open Document\u2026](command:mrw.openDocument \"Open a note, paper or ordinary file in place.\")\n[Open Saved Source\u2026](command:mrw.openOutline \"Open retained source passages and their reader notes.\")\n\n[Reading and notes](command:mrw.readingTools) \u00b7 [Sources and references](command:mrw.sourceTools)\n[Calculation](command:mrw.calculationTools) \u00b7 [Proofs](command:mrw.proofTools)\n[Tools and setup](command:mrw.companionTools) \u00b7 [Earlier saved work](command:mrw.earlierWork)\n\n[Tutorial](command:mrw.openTutorial \"Read instructions for the active MRW version.\")"
      },
      {
        "view": "mrw.readingOutline",
        "contents": "Open a Markdown document using Commands below. Contents shows its headings and links, including unsaved edits."
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mrw",
          "title": "MRW 0.23.35",
          "icon": "media/mrw.svg"
        }
      ]
    },
    "submenus": [
      {
        "id": "mrw.documentNavigation",
        "label": "MRW Document",
        "icon": "$(book)"
      }
    ]
  },
