{
  "name": "theorem-terminal",
  "displayName": "Mathematical Research Workstation",
  "description": "Research continuity and retained mathematical evidence alongside Lean, LaTeX, and ordinary notes.",
  "version": "0.6.1",
  "publisher": "flengyel",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/flengyel/theorem_terminal.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Record actions launch the bundled Python service on explicit command."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "This increment requires local files in the extension host (including WSL/SSH)."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "mrw.mark",
        "title": "Mark Return Location",
        "category": "MRW",
        "icon": "$(bookmark)"
      },
      {
        "command": "mrw.return",
        "title": "Return to Marked Location",
        "category": "MRW",
        "icon": "$(go-to-file)"
      },
      {
        "command": "mrw.clearMark",
        "title": "Clear Return Location",
        "category": "MRW"
      },
      {
        "command": "mrw.openProof",
        "title": "Open Lean Proof and Keep Return Location",
        "category": "MRW"
      },
      {
        "command": "mrw.openViewer",
        "title": "Open External Proof Viewer",
        "category": "MRW"
      },
      {
        "command": "mrw.inspect",
        "title": "Inspect Retained Record",
        "category": "MRW"
      },
      {
        "command": "mrw.review",
        "title": "Review Model Response",
        "category": "MRW"
      },
      {
        "command": "mrw.passage",
        "title": "Show Response Passage",
        "category": "MRW"
      },
      {
        "command": "mrw.index",
        "title": "Show Response Index Page",
        "category": "MRW"
      },
      {
        "command": "mrw.fullResponse",
        "title": "Show Full Response",
        "category": "MRW"
      },
      {
        "command": "mrw.retain",
        "title": "Retain Response Passage",
        "category": "MRW"
      },
      {
        "command": "mrw.insert",
        "title": "Insert Attributed Passage into Active Note",
        "category": "MRW"
      },
      {
        "command": "mrw.ask",
        "title": "Ask About Selected Work",
        "category": "MRW"
      },
      {
        "command": "mrw.addContext",
        "title": "Add Selection to Request",
        "category": "MRW"
      },
      {
        "command": "mrw.removeContext",
        "title": "Remove Request Context",
        "category": "MRW"
      },
      {
        "command": "mrw.editQuestion",
        "title": "Edit Mathematical Question",
        "category": "MRW"
      },
      {
        "command": "mrw.previewRequest",
        "title": "Show Exact Request Preview",
        "category": "MRW"
      },
      {
        "command": "mrw.discardRequest",
        "title": "Discard Unsent Request",
        "category": "MRW"
      },
      {
        "command": "mrw.sendRequest",
        "title": "Send Exact Preview",
        "category": "MRW"
      },
      {
        "command": "mrw.continueAnswer",
        "title": "Continue an Initial Answer Once",
        "category": "MRW",
        "enablement": "!mrw.assistanceBusy"
      },
      {
        "command": "mrw.selectPriorPassages",
        "title": "Select Prior Response Passages",
        "category": "MRW",
        "enablement": "!mrw.assistanceBusy"
      },
      {
        "command": "mrw.editCorrection",
        "title": "Edit Human Correction",
        "category": "MRW",
        "enablement": "!mrw.assistanceBusy"
      },
      {
        "command": "mrw.editConclusion",
        "title": "Edit Last Useful Conclusion",
        "category": "MRW",
        "enablement": "!mrw.assistanceBusy"
      },
      {
        "command": "mrw.editIssue",
        "title": "Edit Unresolved Issue",
        "category": "MRW",
        "enablement": "!mrw.assistanceBusy"
      },
      {
        "command": "mrw.resumeInvestigation",
        "title": "Resume Saved Investigation",
        "category": "MRW",
        "enablement": "!mrw.assistanceBusy"
      },
      {
        "command": "mrw.saveInvestigationSummary",
        "title": "Save Human Task Summary",
        "category": "MRW",
        "enablement": "!mrw.assistanceBusy"
      },
      {
        "command": "mrw.insertInvestigationHandoff",
        "title": "Insert Investigation Handoff into Active Note",
        "category": "MRW",
        "enablement": "!mrw.assistanceBusy"
      },
      {
        "command": "mrw.reviewInvestigationParent",
        "title": "Review Investigation Parent",
        "category": "MRW",
        "enablement": "!mrw.assistanceBusy"
      },
      {
        "command": "mrw.reviewInvestigationChild",
        "title": "Review Investigation Completed Child",
        "category": "MRW",
        "enablement": "!mrw.assistanceBusy"
      },
      {
        "command": "mrw.endInvestigation",
        "title": "End Investigation\u2026",
        "category": "MRW",
        "enablement": "!mrw.assistanceBusy"
      },
      {
        "command": "mrw.editInvestigationQuestion",
        "title": "Edit Investigation Current Question",
        "category": "MRW",
        "enablement": "!mrw.assistanceBusy"
      },
      {
        "command": "mrw.createOutline",
        "title": "Create Outline from Saved Source",
        "category": "MRW",
        "enablement": "!mrw.outlineBusy"
      },
      {
        "command": "mrw.openOutline",
        "title": "Open Saved Source Outline\u2026",
        "category": "MRW",
        "enablement": "!mrw.outlineBusy"
      },
      {
        "command": "mrw.addOutlineRegion",
        "title": "Add Selected Source Region",
        "category": "MRW",
        "enablement": "!mrw.outlineBusy"
      },
      {
        "command": "mrw.replaceOutlineRegion",
        "title": "Replace Selected Outline Region Range",
        "category": "MRW",
        "enablement": "!mrw.outlineBusy"
      },
      {
        "command": "mrw.setOutlineStatement",
        "title": "Use Selection as Exact Statement",
        "category": "MRW",
        "enablement": "!mrw.outlineBusy"
      },
      {
        "command": "mrw.addOutlineContext",
        "title": "Keep Selected Hypothesis / Cited Result",
        "category": "MRW",
        "enablement": "!mrw.outlineBusy"
      },
      {
        "command": "mrw.replaceOutlineContext",
        "title": "Replace Shared Context with Selection\u2026",
        "category": "MRW",
        "enablement": "!mrw.outlineBusy"
      },
      {
        "command": "mrw.attachOutlineEvidence",
        "title": "Attach Recorded Outline Evidence\u2026",
        "category": "MRW",
        "enablement": "!mrw.outlineBusy"
      },
      {
        "command": "mrw.insertOutlineReference",
        "title": "Insert Outline Reference\u2026",
        "category": "MRW",
        "enablement": "!mrw.outlineBusy"
      },
      {
        "command": "mrw.followOutlineReference",
        "title": "Follow Outline Reference at Cursor",
        "category": "MRW",
        "enablement": "!mrw.outlineBusy"
      },
      {
        "command": "mrw.copyOutlineLink",
        "title": "Copy Outline or Passage Link\u2026",
        "category": "MRW",
        "enablement": "!mrw.outlineBusy"
      },
      {
        "command": "mrw.openLinkFromClipboard",
        "title": "Open Link from Clipboard",
        "category": "MRW",
        "enablement": "!mrw.outlineBusy"
      },
      {
        "command": "mrw.associateObsidianNote",
        "title": "Link an Obsidian Note\u2026",
        "category": "MRW",
        "enablement": "!mrw.outlineBusy"
      },
      {
        "command": "mrw.openObsidianNote",
        "title": "Open Linked Note in Obsidian\u2026",
        "category": "MRW",
        "enablement": "!mrw.outlineBusy"
      },
      {
        "command": "mrw.manageObsidianNotes",
        "title": "Manage Linked Notes\u2026",
        "category": "MRW",
        "enablement": "!mrw.outlineBusy"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "mrw.research",
          "name": "Mathematical Research"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "mrw.mark",
          "when": "view == mrw.research",
          "group": "navigation"
        },
        {
          "command": "mrw.return",
          "when": "view == mrw.research",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "mrw.mark",
          "when": "resourceScheme == file",
          "group": "mrw"
        },
        {
          "command": "mrw.openProof",
          "when": "resourceScheme == file",
          "group": "mrw"
        },
        {
          "command": "mrw.ask",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == untitled)",
          "group": "mrw"
        },
        {
          "command": "mrw.createOutline",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == mrw-record)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.addOutlineRegion",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == mrw-record)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.replaceOutlineRegion",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == mrw-record)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.setOutlineStatement",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == mrw-record)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.addOutlineContext",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == mrw-record)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.insertOutlineReference",
          "when": "editorLangId == markdown && (resourceScheme == file || resourceScheme == untitled)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.followOutlineReference",
          "when": "editorLangId == markdown && (resourceScheme == file || resourceScheme == untitled)",
          "group": "mrw-outline"
        }
      ]
    },
    "configuration": {
      "title": "Mathematical Research Workstation",
      "properties": {
        "mrw.pythonExecutable": {
          "type": "string",
          "default": "python3",
          "scope": "machine",
          "description": "Python 3.11+ executable on the extension host. One executable, without shell arguments. Configure in User or Remote settings."
        },
        "mrw.proofViewerUrl": {
          "type": "string",
          "default": "https://arkitect-lab.k-inside.com/proofmaps/",
          "scope": "machine",
          "description": "HTTPS proof viewer opened only by its explicit command. No local source or path is appended or uploaded."
        },
        "mrw.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "OpenAI model identifier. If empty, Ask prompts for this request. Credentials come only from OPENAI_API_KEY on the extension host."
        },
        "mrw.navigationWorkspaceUri": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional stable workspace routing URI for companion links. File URI on Linux or vscode-remote://ssh-remote+HOST/path. WSL uses WSL_DISTRO_NAME automatically. This must name the current folder or saved workspace file; target identity remains independently scoped."
        }
      }
    }
  },
  "scripts": {
    "bundle-core": "python3 scripts/bundle-core.py",
    "vscode:prepublish": "npm run bundle-core",
    "test": "node --test test/*.test.js",
    "check": "node --check src/extension.js && node --check src/bridge.js && node --check src/navigation.js && node --check src/assistance.js && node --check src/investigation.js && node --check src/outlines.js && node --check src/outlineView.js && node --check src/outlineReferences.js && node --check src/companionLinks.js",
    "package": "vsce package --no-dependencies --baseContentUrl https://github.com/flengyel/theorem_terminal/blob/main/vscode",
    "verify-vsix": "python3 scripts/verify-vsix.py"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  },
  "activationEvents": [
    "onUri"
  ]
}
