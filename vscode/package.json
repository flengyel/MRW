      "editor/context": [
        {
          "command": "mrw.studyCurrent",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "mrw@0"
        },
        {
          "command": "mrw.mark",
          "when": "resourceScheme == file",
          "group": "mrw"
        },
        {
          "command": "mrw.openProof",
          "when": "resourceScheme == file",
          "group": "mrw"
        },
        {
          "command": "mrw.ask",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == untitled)",
          "group": "mrw"
        },
        {
          "command": "mrw.createOutline",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == mrw-record)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.addOutlineRegion",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == mrw-record)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.replaceOutlineRegion",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == mrw-record)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.setOutlineStatement",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == mrw-record)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.addOutlineContext",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == mrw-record)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.insertOutlineReference",
          "when": "editorLangId == markdown && (resourceScheme == file || resourceScheme == untitled)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.followOutlineReference",
          "when": "editorLangId == markdown && (resourceScheme == file || resourceScheme == untitled)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.openReadingOutline",
          "when": "editorLangId == markdown && (resourceScheme == file || resourceScheme == untitled)",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.followDocumentLink",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "mrw-outline"
        },
        {
          "command": "mrw.showBacklinks",
          "when": "editorLangId == markdown && resourceScheme == file",
          "group": "mrw-outline"
        }
