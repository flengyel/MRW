      "commandPalette": [
        {
          "command": "mrw.selectReadingOutlineItem",
          "when": "false"
        },
        {
          "command": "mrw.openStudyItem",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "mrw.openProofOutline",
          "when": "resourceFilename =~ /\\.mrw-proof\\.json$/",
          "group": "navigation"
        },
        {
          "command": "mrw.resumeProofStudy",
          "when": "resourceFilename =~ /\\.mrw-study\\.json$/",
          "group": "navigation"
        },
        {
          "command": "mrw.studyCurrent",
          "when": "editorHasSelection && resourceScheme == file && !(resourceFilename =~ /\\.mrw-(proof|study)\\.json$/)",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Mathematical Research Workstation",
      "properties": {
        "mrw.pythonExecutable": {
          "type": "string",
          "default": "python3",
          "scope": "machine",
          "description": "Python 3.11+ executable on the extension host. One executable, without shell arguments. Configure in User or Remote settings."
        },
        "mrw.proofViewerUrl": {
          "type": "string",
          "default": "https://arkitect-lab.k-inside.com/proofmaps/",
          "scope": "machine",
          "description": "HTTPS proof viewer opened only by its explicit command. No local source or path is appended or uploaded."
        },
        "mrw.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "OpenAI model identifier. If empty, Ask prompts for this request. Credentials come only from OPENAI_API_KEY on the extension host."
        },
        "mrw.navigationWorkspaceUri": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional stable workspace routing URI for companion links. File URI on Linux or vscode-remote://ssh-remote+HOST/path. WSL uses WSL_DISTRO_NAME automatically. This must name the current folder or saved workspace file; target identity remains independently scoped."
        },
        "mrw.artifactMoveDestination": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Suggested destination for Move Saved Work Directory. Changing this setting never changes the active store or moves saved work; use the explicit command."
        },
        "mrw.studyQuestions": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Questions per short study block. Prototype default; stops at an attempt boundary."
        },
        "mrw.studyMinutes": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 30,
          "description": "Approximate minutes per block. Time is not a mental-effort measure."
        },
        "mrw.studyNewQuestions": {
          "type": "integer",
          "default": 1,
