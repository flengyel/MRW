{
  "name": "mrw",
  "displayName": "Mathematical Research Workstation",
  "description": "Investigate mathematical questions, reconstruct arguments, and develop proofs with your sources and notes.",
  "version": "0.22.0",
  "publisher": "flengyel",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/flengyel/MRW.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Record actions launch the bundled Python service on explicit command."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "This increment requires local files in the extension host (including WSL/SSH)."
    }
  },
  "contributes": {
    "markdown.previewStyles": [
      "./media/diagram-theme.css"
    ],
    "commands": [
